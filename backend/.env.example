# Copy to .env and fill in. Never commit .env.
# Only the "Server" keys are used today; the rest become required in the spec that uses them.

# --- Server (spec 001) ---
# development | test | production
NODE_ENV=development
# Port the API listens on (1-65535)
PORT=3001
# error | warn | info | debug (default: debug in development, info in production, error in test)
LOG_LEVEL=debug
# Comma-separated browser origins allowed to call the API (scheme + host + port, no path)
CORS_ORIGINS=http://localhost:5173
# Max JSON request body size, e.g. 100kb or 1mb
JSON_BODY_LIMIT=100kb

# --- Claude API (spec 010) ---
# Secret: get from console.anthropic.com
ANTHROPIC_API_KEY=
# Model ID to use for chat and analysis
CLAUDE_MODEL=

# --- Riot Games API (spec 007) ---
# Secret: get from developer.riotgames.com
RIOT_API_KEY=
# Platform routing value, e.g. na1, euw1
RIOT_API_REGION=na1

# --- Data stores (later specs) ---
# e.g. redis://localhost:6379
REDIS_URL=
# e.g. postgres://user:password@localhost:5432/gaming_companion
DATABASE_URL=

# --- Auth (spec 002) ---
# Secret: long random string used to sign tokens
JWT_SECRET=
