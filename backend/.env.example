PORT=8000
NODE_ENV=development

# Required: long random string used to sign login tokens
JWT_SECRET=change-me

# Postgres. Local (matches docker-compose.yml):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gaming_companion
# Or Neon (project-ai-companion): copy the connection string from the Neon
# console and use sslmode=verify-full, e.g.
# DATABASE_URL=postgresql://<role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/gaming_companion?channel_binding=require&sslmode=verify-full

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

ANTHROPIC_API_KEY=
# Optional model settings (defaults shown)
# CHAT_MODEL=claude-opus-5-5
# CHAT_EFFORT=medium
# CLAUDE_MODEL=claude-opus-5-5   # agent analysis
# CLAUDE_EFFORT=high
# CLAUDE_MAX_TOKENS=16000
# AGENT_TIMEOUT_MS=300000       # agent analysis time limit (5 minutes)
RIOT_API_KEY=
RIOT_API_REGION=na1
